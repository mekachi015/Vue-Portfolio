details {\r\n  margin-top: 1rem;\r\n  padding-top: 1rem;\r\n  border-top: 1px solid #eee;\r\n}\r\n\r\n.skill-details p {\r\n  font-size: 0.9rem;\r\n  color: #666;\r\n  line-height: 1.5;\r\n  margin: 0;\r\n}\r\n\r\n.skill-card-animate {\r\n  animation: fadeInUp 0.5s ease forwards;\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(-20px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n@keyframes fadeInUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(20px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .skills-grid {\r\n    grid-auto-columns: minmax(260px, 320px);\r\n  }\r\n  \r\n  .category-filters {\r\n    padding: 0 0.5rem;\r\n  }\r\n  \r\n  .filter-btn {\r\n    padding: 0.4rem 1rem;\r\n    font-size: 0.9rem;\r\n    white-space: nowrap;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n    .skills-grid {\r\n    grid-auto-columns: minmax(240px, 300px);\r\n  }\r\n\r\n  .skill-card {\r\n    min-width: 240px;\r\n  }\r\n\r\n  .skills-scroll::before,\r\n  .skills-scroll::after {\r\n    width: 30px;\r\n  }\r\n}\r\n</style>"],"mappings":";;AAsDA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE,KAAK;MACrBC,aAAa,EAAE,IAAI;MACnBC,UAAU,EAAE,CAAC,KAAK,EAAE,UAAU,EAAE,SAAS,EAAE,UAAU,EAAE,OAAO,CAAC;MAC/DC,MAAM,EAAE,CACN;QACEL,IAAI,EAAE,QAAQ;QACdM,WAAW,EAAE,EAAE;QACfC,IAAI,EAAE,cAAc;QACpBC,QAAQ,EAAE,UAAU;QACpBC,WAAW,EAAE;MACf,CAAC,EACD;QACET,IAAI,EAAE,YAAY;QAClBM,WAAW,EAAE,EAAE;QACfC,IAAI,EAAE,WAAW;QACjBC,QAAQ,EAAE,UAAU;QACpBC,WAAW,EAAE;MACf,CAAC,EACD;QACET,IAAI,EAAE,UAAU;QAChBM,WAAW,EAAE,EAAE;QACfC,IAAI,EAAE,cAAc;QACpBC,QAAQ,EAAE,UAAU;QACpBC,WAAW,EAAE;MACf,CAAC,EACD;QACET,IAAI,EAAE,MAAM;QACZM,WAAW,EAAE,EAAE;QACfC,IAAI,EAAE,aAAa;QACnBC,QAAQ,EAAE,SAAS;QACnBC,WAAW,EAAE;MACf,CAAC,EACD;QACET,IAAI,EAAE,SAAS;QACfM,WAAW,EAAE,EAAE;QACfC,IAAI,EAAE,gBAAgB;QACtBC,QAAQ,EAAE,SAAS;QACnBC,WAAW,EAAE;